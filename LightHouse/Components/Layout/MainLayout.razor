@inherits LayoutComponentBase



<div class="page">
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>



<!-- Footer -->
<footer class="site-footer">
    <div class="footer-content">
        <!-- Column 1: Brand -->
        <div class="footer-column">
            <h3>THE LIGHTHOUSE</h3>
            <p class="footer-desc">Your Block-Chain Guide</p>
        </div>

        <!-- Column 2: Quick Links -->
        <div class="footer-column">
            <h4>Quick Links</h4>
            <ul class="footer-links">
                <li><a href="/">Home</a></li>
                <li><a href="/explore">Explore</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
        </div>

        <!-- Column 3: Social Media -->
        <div class="footer-column">
            <h4>Follow Us</h4>
            <div class="social-links">
                <a href="#" class="social-icon" title="Twitter">🐦</a>
                <a href="#" class="social-icon" title="Discord">💬</a>
                <a href="#" class="social-icon" title="GitHub">🐙</a>
                <a href="#" class="social-icon" title="YouTube">▶️</a>
            </div>
        </div>

        <!-- Column 4: Newsletter or extra info -->
        <div class="footer-column">
            <h4>Stay Updated</h4>
            <p class="newsletter-text">Get the latest blockchain insights</p>
            <div class="newsletter-form">
                <input type="email" placeholder="Your email" class="footer-input" />
                <button class="footer-btn">Subscribe</button>
            </div>
        </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
        <p>&copy; @DateTime.Now.Year THE LIGHTHOUSE. All rights reserved.</p>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    /* Footer container */
    .site-footer {
        background-color: #111;
        color: #ccc;
        padding: 60px 40px 20px 40px;
        margin-top: 80px;
        border-top: 1px solid rgba(255, 59, 48, 0.3);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Footer grid layout */
    .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Footer columns */
    .footer-column h3 {
        color: white;
        font-size: 1.5rem;
        margin: 0 0 8px 0;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .footer-column h4 {
        color: white;
        font-size: 1.1rem;
        margin: 0 0 12px 0;
        letter-spacing: 0.5px;
    }

    .footer-desc {
        color: #999;
        font-size: 0.9rem;
        margin: 0;
    }

    /* Links */
    .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-links li {
        margin-bottom: 8px;
    }

    .footer-links a {
        color: #999;
        text-decoration: none;
        transition: color 0.3s ease;
        font-size: 0.95rem;
    }

    .footer-links a:hover {
        color: #FF3B30;
    }

    /* Social media icons */
    .social-links {
        display: flex;
        gap: 15px;
    }

    .social-icon {
        color: #999;
        font-size: 1.5rem;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .social-icon:hover {
        color: #FF3B30;
        transform: scale(1.2);
    }

    /* Newsletter */
    .newsletter-text {
        color: #999;
        font-size: 0.9rem;
        margin: 0 0 10px 0;
    }

    .newsletter-form {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .footer-input {
        flex: 1;
        min-width: 120px;
        padding: 8px 12px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        background: transparent;
        color: white;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.3s ease;
    }

    .footer-input:focus {
        border-color: #FF3B30;
    }

    .footer-input::placeholder {
        color: #666;
    }

    .footer-btn {
        padding: 8px 16px;
        background: transparent;
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .footer-btn:hover {
        background: #FF3B30;
        border-color: #FF3B30;
        color: white;
    }

    /* Bottom bar */
    .footer-bottom {
        text-align: center;
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        color: #666;
        font-size: 0.85rem;
    }

    /* Mobile responsiveness */
    @@media (max-width: 768px) {
        .site-footer {
            padding: 40px 20px 20px 20px;
        }
        .footer-content {
            grid-template-columns: 1fr;
            gap: 30px;
        }
        .social-links {
            justify-content: flex-start;
        }
        .newsletter-form {
            flex-direction: column;
        }
        .footer-input {
            width: 100%;
        }
        .footer-btn {
            width: 100%;
        }
    }
</style>