@using LightHouse.Core.Models
@inject NavigationManager Navigation

@if (Network is not null)
{
    <article class="network-card">
        <header class="card-header">
            <div class="network-identity">
                <div class="logo-wrap">
                    <img src="@Network.LogoUrl"
                         alt=""
                         class="network-logo"
                         loading="lazy"
                         onerror="this.style.display='none'; this.parentElement.classList.add('fallback');" />
                    <span class="logo-fallback" aria-hidden="true">@(string.IsNullOrEmpty(Network.Symbol) ? "?" : Network.Symbol[..1])</span>
                </div>

                <div class="network-titles">
                    <h2 class="network-name">@Network.Name</h2>
                    <span class="network-symbol">@Network.Symbol</span>
                </div>
            </div>

            <span class="status-badge @StatusClass">@Network.Status</span>
        </header>

        <div class="metrics">
            <div class="metric">
                <span class="metric-label">Gas Fee</span>
                <strong class="metric-value">@FormatGas(Network.GasFee) <span class="unit">@Network.GasUnit</span></strong>
            </div>

            <div class="metric">
                <span class="metric-label">TPS</span>
                <strong class="metric-value">@Network.TransactionsPerSecond.ToString("N0")</strong>
            </div>

            <div class="metric">
                <span class="metric-label">Congestion</span>
                <strong class="metric-value @CongestionClass">@Network.Congestion</strong>
            </div>

            <div class="metric">
                <span class="metric-label">Finality</span>
                <strong class="metric-value">@Network.FinalitySeconds<span class="unit">s</span></strong>
            </div>
        </div>

        <footer class="card-footer">
            <time class="last-update" datetime="@Network.LastUpdated.ToString("o")">
                Updated @Network.LastUpdated.ToLocalTime().ToString("HH:mm:ss")
            </time>

            <button type="button" class="details-btn" @onclick="OpenDetails">
                View details
                <span class="arrow" aria-hidden="true">→</span>
            </button>
        </footer>
    </article>
}

@code {
    [Parameter]
    public Network? Network { get; set; }

    private string StatusClass => Network?.Status switch
    {
        NetworkStatus.Healthy => "is-healthy",
        NetworkStatus.Degraded => "is-degraded",
        NetworkStatus.Offline => "is-offline",
        NetworkStatus.Maintenance => "is-maintenance",
        _ => "is-unknown"
    };

    private string CongestionClass => Network?.Congestion switch
    {
        CongestionLevel.Low => "cong-low",
        CongestionLevel.Medium => "cong-medium",
        CongestionLevel.High => "cong-high",
        _ => string.Empty
    };

    private void OpenDetails()
    {
        if (Network is null) return;
        Navigation.NavigateTo($"/Networks/{Network.Slug}");
    }

    private static string FormatGas(decimal fee)
    {
        if (fee >= 1) return fee.ToString("0.##");
        if (fee >= 0.01m) return fee.ToString("0.###");
        return fee.ToString("0.#####");
    }
}
