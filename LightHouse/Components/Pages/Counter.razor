@page "/counter"
@rendermode InteractiveServer


<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<button class="btn btn-primary" @onclick="IncrementCount">Click to increase</button>
<button class="btn btn-danger" @onclick="DecreaseAmount"> Click to decrease</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private void DecreaseAmount()
    {
        currentCount--;
    }

}

<p role="status">Current count: @currentCount</p>