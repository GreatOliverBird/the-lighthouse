@rendermode InteractiveServer

@if (showBanner)
{
    <div class="cookie-banner" role="dialog" aria-label="Cookie notice">
        <div class="cookie-copy">
            <strong>Cookie notice</strong>
            <p>
                We use cookies to improve The Lighthouse. By continuing, you accept optional analytics cookies.
            </p>
        </div>
        <div class="cookie-actions">
            <button type="button" class="cookie-btn decline" @onclick="Decline">Decline</button>
            <button type="button" class="cookie-btn accept" @onclick="Accept">Accept</button>
        </div>
    </div>
}

@code {
    private bool showBanner = true;

    private void Accept() => showBanner = false;
    private void Decline() => showBanner = false;
}
